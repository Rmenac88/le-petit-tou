# Supabase Database Configuration
# Copy this file to .env and replace with your actual Supabase credentials

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anonymous-anon-key-here
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=votre-cle-mapbox-ici


# Accès bénévole (7 appuis sur le logo). Mettre 1 UNIQUEMENT pour un build interne/dev.
# Ne jamais l'activer dans un build envoyé aux stores.
EXPO_PUBLIC_ENABLE_ADMIN=0
